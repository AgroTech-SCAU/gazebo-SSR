<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="pepper_greenhouse">
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>30 0 4.5 0 0.18 3.14159</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <physics name="ode_1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <include>
      <uri>model://sun</uri>
      <name>sun</name>
      <pose>0.000000 0.000000 10.000000 0.000000 0.000000 0.000000</pose>
    </include>
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0.000000 0.000000 10.000000 0.000000 0.000000 0.000000</pose>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.3 0.5 -0.8</direction>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="floor_collision">
          <pose>0.000000 0.000000 -0.050000 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>100.000000 100.000000 0.100000</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
      </link>
    </model>
    <model name="rails">
      <static>true</static>
      <link name="link">
        <collision name="rail_left">
          <pose>0.000000 -0.334700 0.000500 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>94.000000 0.050000 0.011000</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>10.0</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="rail_left">
          <cast_shadows>true</cast_shadows>
          <pose>0.000000 -0.334700 0.000500 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>94.000000 0.050000 0.011000</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4500 0.4700 0.5000 1.0000</ambient>
            <diffuse>0.6000 0.6200 0.6500 1.0000</diffuse>
            <specular>0.5000 0.5000 0.5000 1.0000</specular>
          </material>
        </visual>
        <collision name="rail_right">
          <pose>0.000000 0.334700 0.000500 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>94.000000 0.050000 0.011000</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>10.0</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="rail_right">
          <cast_shadows>true</cast_shadows>
          <pose>0.000000 0.334700 0.000500 0.000000 0.000000 0.000000</pose>
          <geometry>
            <box>
              <size>94.000000 0.050000 0.011000</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4500 0.4700 0.5000 1.0000</ambient>
            <diffuse>0.6000 0.6200 0.6500 1.0000</diffuse>
            <specular>0.5000 0.5000 0.5000 1.0000</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="greenhouse_aisle_camera">
      <static>true</static>
      <pose>30.000000 0.000000 4.500000 0.000000 0.180000 3.141593</pose>
      <link name="link">
        <sensor type="camera" name="camera">
          <always_on>true</always_on>
          <update_rate>1</update_rate>
          <camera>
            <horizontal_fov>1.2000</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>250.0</far>
            </clip>
          </camera>
          <plugin name="aisle_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/greenhouse</namespace>
              <remapping>image_raw:=image_raw</remapping>
            </ros>
            <camera_name>aisle_camera</camera_name>
            <frame_name>aisle_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
    <model name="greenhouse_bed_camera">
      <static>true</static>
      <pose>2.500000 -18.000000 5.500000 0.000000 0.180000 1.570796</pose>
      <link name="link">
        <sensor type="camera" name="camera">
          <always_on>true</always_on>
          <update_rate>1</update_rate>
          <camera>
            <horizontal_fov>1.2000</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>250.0</far>
            </clip>
          </camera>
          <plugin name="bed_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/greenhouse</namespace>
              <remapping>image_raw:=image_raw</remapping>
            </ros>
            <camera_name>bed_camera</camera_name>
            <frame_name>bed_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
    <include>
      <uri>model://pepper_greenhouse_shell</uri>
      <name>greenhouse_shell</name>
    </include>
    <include>
      <uri>model://pepper_beds_mid</uri>
      <name>beds_mid</name>
    </include>
    <include>
      <uri>model://pepper_beds_end</uri>
      <name>beds_west</name>
      <pose>-34.750000 0.000000 0.000000 0.000000 0.000000 0.000000</pose>
    </include>
    <include>
      <uri>model://pepper_beds_end</uri>
      <name>beds_east</name>
      <pose>34.750000 0.000000 0.000000 0.000000 0.000000 0.000000</pose>
    </include>
  </world>
</sdf>
